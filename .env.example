# Application behavior
APP_ENV=development
LOG_LEVEL=INFO

# Local persistence. Relative paths are resolved from the repository root.
DATA_DIR=./data
DB_PATH=./data/spendarc.duckdb
MAX_UPLOAD_MB=200

# AI is disabled by default. The deterministic summary works without a provider.
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

# Reserved for the post-MVP AWS integration.
AWS_REGION=us-east-1
S3_BUCKET=
ATHENA_DATABASE=
ATHENA_OUTPUT_LOCATION=
